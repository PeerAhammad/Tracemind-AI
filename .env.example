MAX_UPLOAD_BYTES=1000000
# SQLite file location (default: tracemind.db in the working directory)
TRACEMIND_DB=tracemind.db
# Comma-separated frontend origins allowed by CORS (no trailing slash)
CORS_ORIGINS=http://localhost:5173
# Optional regex for preview deployments, e.g. https://tracemind-.*\.vercel\.app
# CORS_ORIGIN_REGEX=
# Optional: override the benchmark task/scenario directories
# TRACEMIND_TASKS_DIR=../benchmarks/tasks
# TRACEMIND_SCENARIOS_DIR=../benchmarks/scenarios
# Not used yet: the app is fully rule-based and needs no LLM key.
LLM_API_KEY=
